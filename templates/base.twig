<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SystemsByBit - AI News{% endblock %}</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<a class="skip-link" href="#main-content">Skip to articles</a>

<header>
    <div class="header-brand-row">
        <div class="brand-copy">
            <a class="site-title" href="/">SystemsByBit: AI News</a>
            <p class="subtitle">Independent AI reporting, gathered in one readable place</p>
        </div>
        <form method="GET" action="/" class="search-form">
            {% if selected_source is defined and selected_source|trim != '' %}
                <input type="hidden" name="source" value="{{ selected_source }}">
            {% endif %}
            {% if pagination is defined %}
                <input type="hidden" name="per_page" value="{{ pagination.per_page }}">
            {% endif %}
            <label class="visually-hidden" for="articleSearch">Search articles</label>
            <input type="text" name="q" placeholder="Search articles..."
                   value="{{ search_query ?? '' }}"
                   class="search-input" id="articleSearch" maxlength="200" autocomplete="off">
            <button type="submit" class="search-btn">Search</button>
            {% if search_query is defined and search_query|trim != '' %}
                <a href="{{ selected_source is defined and selected_source|trim != '' ? '/?source=' ~ (selected_source|url_encode) : '/' }}" class="clear-search">Clear</a>
            {% endif %}
        </form>
    </div>
</header>

<main id="main-content" tabindex="-1">
    {% block content %}{% endblock %}
</main>

<footer>
    <p>
        © {{ "now"|date("Y") }} <a href="https://accessph.net" rel="noopener">ACCESS Software Solutions</a>
        | <a href="https://github.com/aingelc12ell/AINewsCrawlerPHP" rel="noopener">View source</a>
        | <a href="/readme">Readme</a>
    </p>
</footer>
<script src="/js/js.js" defer></script>
</body>
</html>
